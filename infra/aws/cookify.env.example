# Copy to /etc/cookify.env on the EC2 instance (owner root, mode 600) and fill in.
SPRING_PROFILES_ACTIVE=prod

# RDS PostgreSQL
DB_URL=jdbc:postgresql://<rds-endpoint>.ap-south-1.rds.amazonaws.com:5432/cookify
DB_USERNAME=cookify
DB_PASSWORD=<rds-password>

# Generate with: openssl rand -base64 48
JWT_SECRET=<random-base64>

# The CloudFront URL (no trailing slash)
APP_URL=https://<distribution-id>.cloudfront.net

AWS_REGION=ap-south-1
S3_MEDIA_BUCKET=cookify-media-<yourname>
SES_FROM_ADDRESS=Cookify <you@example.com>

# Set to true for the first start to load sample cooks + recipes, then back to false
DEMO_DATA=false
